# =============================================================================
# Application
# =============================================================================
APP_NAME=SPC Platform
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
# Origins allowed to call this API from a browser (comma-separated). The
# React frontend's Vite dev server runs on :5173 by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# PostgreSQL (application metadata, analysis results, baselines, findings)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spc_platform
POSTGRES_USER=spc_app
POSTGRES_PASSWORD=change_me
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_COMMAND_TIMEOUT_SECONDS=30

# =============================================================================
# Snowflake (Bronze/Silver medallion layers for measurement data)
# =============================================================================
# SNOWFLAKE_ROLE and SNOWFLAKE_WAREHOUSE must already exist in your account
# -- scripts/snowflake_ddl.sql only creates the SPC_PLATFORM database/schemas/
# tables/stage, not a role or warehouse. Use a role+warehouse you already
# have (e.g. SYSADMIN / COMPUTE_WH on a trial account), or provision
# dedicated ones first.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=svc_spc_platform
SNOWFLAKE_PASSWORD=change_me
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SPC_PLATFORM
SNOWFLAKE_BRONZE_SCHEMA=BRONZE
SNOWFLAKE_SILVER_SCHEMA=SILVER
SNOWFLAKE_INTERNAL_STAGE=SPC_INGEST_STAGE

# INGESTION_MODE = DEMO | PRODUCTION
# DEMO    -> chunked parameterized batch inserts (no external stage required),
#            suitable for client demonstrations without cloud storage access.
# PRODUCTION -> PUT to internal/external stage + COPY INTO, for high volume loads.
INGESTION_MODE=DEMO
INGESTION_BATCH_ROWS=5000

# =============================================================================
# Uploads
# =============================================================================
UPLOAD_MAX_FILE_SIZE_MB=200
UPLOAD_TEMP_DIR=./var/uploads
UPLOAD_ALLOWED_EXTENSIONS=.csv

# =============================================================================
# SPC defaults (used only when no data-driven configuration exists yet)
# =============================================================================
SPC_DEFAULT_MINIMUM_SAMPLE_SIZE=20
SPC_DEFAULT_SUBGROUP_SIZE=5
SPC_DEFAULT_MAX_TIME_GAP_SECONDS=3600
